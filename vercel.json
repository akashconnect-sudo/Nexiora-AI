{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @nexiora/shared build && pnpm --filter @nexiora/web build",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- ./apps/web ./packages/shared ./packages/ui ./package.json ./pnpm-lock.yaml ./pnpm-workspace.yaml"
}
