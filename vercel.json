{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "node scripts/vercel-web-build.js",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- ./apps/web ./apps/api ./packages/shared ./packages/search-core ./packages/ui ./package.json ./pnpm-lock.yaml ./pnpm-workspace.yaml"
}
