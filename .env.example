# Nexiora AI — Environment Template
# Copy to .env and fill values. Never commit real secrets.

NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://nexiora:nexiora@localhost:5432/nexiora?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# OpenSearch
OPENSEARCH_NODE=http://localhost:9200

# Qdrant
QDRANT_URL=http://localhost:6333

# API
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000
PUBLIC_API_URL=http://localhost:3001
PUBLIC_WEB_URL=http://localhost:3000

# Clerk (https://dashboard.clerk.com)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# OpenAI (optional — extractive synthesizer used when empty)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Stripe (optional — checkout returns setup instructions when empty)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FREE=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Email OTP (Resend recommended — https://resend.com/api-keys)
# When set, login codes go to the user's email and are NOT shown on screen.
RESEND_API_KEY=
EMAIL_FROM=Nexiora AI <onboarding@resend.dev>
# Or use SMTP instead of Resend:
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Observability
OTEL_ENABLED=false
OTEL_SERVICE_NAME=nexiora-api
LOG_LEVEL=info

# Security
IP_HASH_SECRET=change-me-to-a-long-random-string
