# Nexiora AI — Environment Template
# Copy to .env and fill values. Never commit real secrets.

NODE_ENV=development

# PostgreSQL (managed in production — do not run Postgres on the 4 GB VPS)
DATABASE_URL=postgresql://nexiora:nexiora@localhost:5432/nexiora?schema=public

# Redis (VPS in production; local Compose for development)
REDIS_URL=redis://localhost:6379

# OpenSearch (VPS)
OPENSEARCH_NODE=http://localhost:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# Qdrant (VPS)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=doc_embeddings_v1

# API
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000
PUBLIC_API_URL=http://localhost:3001
PUBLIC_WEB_URL=http://localhost:3000

# Clerk + Google sign-in (https://dashboard.clerk.com)
# Enable Google under Clerk > SSO connections. Add these application URLs:
# Local callback: http://localhost:3000/sso-callback
# Production callback: https://YOUR_DOMAIN/sso-callback
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Web — local only. On Vercel web project set this to the DEPLOYED API URL
# (never the web site URL, never localhost).
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# OpenAI (optional — extractive synthesizer used when empty)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMS=1536

# Razorpay (optional — checkout returns setup instructions when empty)
# Key ID is safe for the browser; Key Secret must stay server-only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Email OTP (Resend recommended — https://resend.com/api-keys)
# When set, login codes go to the user's email and are NOT shown on screen.
RESEND_API_KEY=
EMAIL_FROM=Nexiora AI <onboarding@resend.dev>
# Or use SMTP instead of Resend:
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Hybrid search / queues
# inline = run pipeline in API process; queue = enqueue searchId for VPS workers
SEARCH_EXECUTION_MODE=inline
# off | shadow | on — default off preserves live Wikipedia/OpenAlex/HN only
SEARCH_INDEX_READ_MODE=off
SEARCH_INDEX_WRITE_ENABLED=false
SEARCH_INDEX_ALIAS=documents_read
SEARCH_INDEX_WRITE_ALIAS=documents_write
QUEUE_PREFIX_ENV=development
WORKER_CONCURRENCY=2
INDEX_RETRIEVAL_TIMEOUT_MS=1800

# Observability (OTLP HTTP → VPS collector)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=nexiora-api
OTEL_SERVICE_VERSION=0.1.0
OTEL_DEPLOYMENT_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.2
LOG_LEVEL=info

# Security
IP_HASH_SECRET=change-me-to-a-long-random-string
AUTH_JWT_SECRET=change-me-to-another-long-secret
