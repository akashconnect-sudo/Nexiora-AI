{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && node scripts/vercel-web-build.js",
  "functions": {
    "src/app/api/[[...path]]/route.ts": {
      "includeFiles": "nest-dist/**,nest-loader.cjs",
      "maxDuration": 60
    }
  }
}
