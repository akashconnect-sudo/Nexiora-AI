{
  "name": "@nexiora/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Nexiora AI background workers (BullMQ) — VPS consumer entry",
  "scripts": {
    "dev": "pnpm --filter @nexiora/api worker:dev",
    "build": "pnpm --filter @nexiora/api build",
    "start": "pnpm --filter @nexiora/api worker",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"lint: worker ok\"",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@nexiora/search-core": "workspace:*",
    "@nexiora/shared": "workspace:*",
    "@nexiora/telemetry": "workspace:*",
    "@opensearch-project/opensearch": "^3.6.0",
    "@prisma/client": "^6.1.0",
    "@qdrant/js-client-rest": "^1.18.0",
    "bullmq": "^5.80.9",
    "ioredis": "^5.4.2",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
